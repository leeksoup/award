<?php

/**
 * @file
 * Install and update hooks for the LMS Forum Prompt module.
 */

declare(strict_types=1);

/**
 * Hides the internal topic reference from the Forum Prompt authoring form.
 */
function lms_forum_prompt_update_10001(): void {
  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('lms_activity.forum_prompt.default');

  if ($display === NULL) {
    return;
  }

  $display
    ->removeComponent('field_forum_topic')
    ->save();
}

/**
 * Adds an exposed topic-title field while keeping the topic reference internal.
 */
function lms_forum_prompt_update_10002(): void {
  \Drupal::service('config.installer')->installDefaultConfig(
    'module',
    'lms_forum_prompt',
  );

  $display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('lms_activity.forum_prompt.default');

  if ($display === NULL) {
    return;
  }

  $display
    ->setComponent('field_forum_topic_title', [
      'type' => 'string_textfield',
      'weight' => 1,
      'region' => 'content',
      'settings' => [
        'size' => 60,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ])
    ->removeComponent('field_forum_topic')
    ->save();
}
