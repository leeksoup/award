<?php

declare(strict_types=1);

/**
 * @file
 * Database schema for Commerce LMS Entitlements.
 */

/**
 * Implements hook_schema().
 */
function commerce_lms_entitlements_schema(): array {
  $schema['commerce_lms_entitlement'] = [
    'description' => 'A learner entitlement derived from one Commerce purchase.',
    'fields' => [
      'eid' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'offer_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'purchase_type' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'purchaser_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'learner_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'invitation_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'order_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'payment_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'paypal_subscription_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'paypal_plan_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'subscription_campaign_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'promotion_uuid' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'coupon_uuid' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'checkout_token' => ['type' => 'varchar', 'length' => 80, 'not null' => FALSE],
      'checkout_snapshot' => ['type' => 'blob', 'size' => 'big', 'not null' => FALSE],
      'vip_selected' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'vip_active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'initial_capture_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'refund_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'pending'],
      'activated' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'access_through' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'guarantee_requested' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['eid'],
    'unique keys' => ['order' => ['order_id'], 'paypal_subscription' => ['paypal_subscription_id'], 'checkout_token' => ['checkout_token']],
    'indexes' => ['reconcile' => ['status', 'access_through'], 'purchaser' => ['purchaser_uid']],
  ];
  $schema['commerce_lms_entitlement_membership'] = [
    'description' => 'Class memberships supported by an entitlement.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'eid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'class_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'membership_created' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'benefit' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'base'],
      'active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['entitlement_class_benefit' => ['eid', 'class_id', 'benefit']],
    'indexes' => ['class_user_active' => ['class_id', 'uid', 'active']],
  ];
  $schema['commerce_lms_entitlement_event'] = [
    'description' => 'Deduplicated, verified PayPal subscription webhook events.',
    'fields' => [
      'event_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'paypal_subscription_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'gateway_id' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'event_type' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'payload' => ['type' => 'blob', 'size' => 'big', 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'queued'],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['event_id'],
    'indexes' => ['subscription' => ['paypal_subscription_id']],
  ];
  $schema['commerce_lms_entitlement_invitation'] = [
    'description' => 'One-time learner invitation tokens, stored only as hashes.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'email' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
      'token_hash' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'claimed_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'expires' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['token_hash' => ['token_hash']],
  ];
  $schema['commerce_lms_plan_change'] = [
    'description' => 'Auditable PayPal subscription tier revisions.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'eid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'from_tier' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'to_tier' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'from_plan_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'target_plan_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'state_hash' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'approval_pending'],
      'requested' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'effective' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'error' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => ['entitlement_status' => ['eid', 'status']],
  ];
  $schema['commerce_lms_vip_booking'] = [
    'description' => 'Active one-per-month VIP registrant reservations.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'month_key' => ['type' => 'varchar', 'length' => 7, 'not null' => TRUE],
      'eventinstance_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'registrant_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['learner_month' => ['uid', 'month_key'], 'registrant' => ['registrant_id']],
    'indexes' => ['eventinstance' => ['eventinstance_id']],
  ];
  return $schema;
}

/**
 * Expands legacy recurring offers into separate sandbox and live mappings.
 */
function commerce_lms_entitlements_update_10011(): string {
  $gateway_storage = \Drupal::entityTypeManager()->getStorage('commerce_payment_gateway');
  $offer_storage = \Drupal::entityTypeManager()->getStorage('commerce_lms_offer');
  $updated = 0;

  foreach ($offer_storage->loadMultiple() as $offer) {
    if ($offer->getPurchaseType() !== 'recurring' || $offer->getActivePayPalGatewayId() !== '') {
      continue;
    }

    $gateway_id = $offer->getPaymentGatewayId();
    $plan_id = $offer->getPayPalPlanId();
    $gateway = $gateway_id !== '' ? $gateway_storage->load($gateway_id) : NULL;
    $environment = $gateway && $gateway->getPlugin()->getMode() === 'live'
      ? 'live'
      : 'sandbox';

    $offer->set('paypal_environment', $environment);
    $offer->set('paypal_' . $environment . '_gateway_id', $gateway_id);
    $offer->set('paypal_' . $environment . '_plan_id', $plan_id);

    // The original model did not store cadence. Preserve the known offer
    // conventions without changing entity IDs or migration references.
    $identity = strtolower($offer->id() . ' ' . $offer->label());
    if (str_contains($identity, 'annual') || str_contains($identity, 'year')) {
      $offer->set('billing_interval', 'annual');
    }
    elseif (str_contains($identity, 'quarter')) {
      $offer->set('billing_interval', 'quarterly');
    }
    else {
      $offer->set('billing_interval', 'monthly');
    }
    $offer->save();
    $updated++;
  }

  return (string) t('Expanded @count recurring LMS offers into environment-specific PayPal mappings.', [
    '@count' => $updated,
  ]);
}

/**
 * Adds VIP subscription tiers, plan-change audit, and booking ownership.
 */
function commerce_lms_entitlements_update_10012(): string {
  $schema = \Drupal::database()->schema();
  $definition = commerce_lms_entitlements_schema();
  foreach (['paypal_plan_id', 'vip_selected', 'vip_active'] as $field) {
    if (!$schema->fieldExists('commerce_lms_entitlement', $field)) {
      $schema->addField('commerce_lms_entitlement', $field, $definition['commerce_lms_entitlement']['fields'][$field]);
    }
  }
  if (!$schema->fieldExists('commerce_lms_entitlement_membership', 'benefit')) {
    $schema->addField('commerce_lms_entitlement_membership', 'benefit', $definition['commerce_lms_entitlement_membership']['fields']['benefit']);
  }
  if ($schema->indexExists('commerce_lms_entitlement_membership', 'entitlement_class')) {
    $schema->dropUniqueKey('commerce_lms_entitlement_membership', 'entitlement_class');
  }
  if (!$schema->indexExists('commerce_lms_entitlement_membership', 'entitlement_class_benefit')) {
    $schema->addUniqueKey('commerce_lms_entitlement_membership', 'entitlement_class_benefit', ['eid', 'class_id', 'benefit']);
  }
  foreach (['commerce_lms_plan_change', 'commerce_lms_vip_booking'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition[$table]);
    }
  }

  $vip_config = \Drupal::configFactory()->getEditable('commerce_lms_entitlements.vip');
  if ($vip_config->get('hub_course_id') === NULL) {
    $vip_config
      ->set('hub_course_id', 0)
      ->set('hub_class_id', 0)
      ->set('event_series_ids', [])
      ->set('meeting_url', '')
      ->set('change_cutoff_hours', 24)
      ->save();
  }

  $database = \Drupal::database();
  $offer_storage = \Drupal::entityTypeManager()->getStorage('commerce_lms_offer');
  $order_storage = \Drupal::entityTypeManager()->getStorage('commerce_order');
  foreach ($database->select('commerce_lms_entitlement', 'e')->fields('e', ['eid', 'offer_id', 'order_id'])->execute() as $row) {
    $offer = $offer_storage->load($row->offer_id);
    if ($offer && $offer->getPurchaseType() === 'recurring') {
      $order = $order_storage->load($row->order_id);
      $gateway_id = (string) ($order?->get('payment_gateway')->target_id ?? '');
      if ($gateway_id !== '' && $gateway_id === $offer->getPayPalSandboxGatewayId()) {
        $plan_id = $offer->getPayPalSandboxPlanId();
      }
      elseif ($gateway_id !== '' && $gateway_id === $offer->getPayPalLiveGatewayId()) {
        $plan_id = $offer->getPayPalLivePlanId();
      }
      else {
        $plan_id = $offer->getActivePayPalPlanId();
      }
      $database->update('commerce_lms_entitlement')
        ->fields(['paypal_plan_id' => $plan_id])
        ->condition('eid', $row->eid)
        ->isNull('paypal_plan_id')
        ->execute();
    }
  }
  return (string) t('Added VIP plan, access, revision, and booking storage.');
}

/**
 * Adds subscription campaign audit metadata to entitlements.
 */
function commerce_lms_entitlements_update_10013(): string {
  $schema = \Drupal::database()->schema();
  $definition = commerce_lms_entitlements_schema()['commerce_lms_entitlement'];
  $added = 0;
  foreach (['subscription_campaign_id', 'promotion_uuid', 'coupon_uuid'] as $field) {
    if (!$schema->fieldExists('commerce_lms_entitlement', $field)) {
      $schema->addField('commerce_lms_entitlement', $field, $definition['fields'][$field]);
      $added++;
    }
  }

  return (string) t('Added @count subscription campaign audit fields.', ['@count' => $added]);
}

/**
 * Marks previously accepted PayPal catalog events as non-actionable.
 */
function commerce_lms_entitlements_update_10014(): string {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('commerce_lms_entitlement_event')) {
    return (string) t('No PayPal entitlement event table exists.');
  }
  $query = $database->update('commerce_lms_entitlement_event');
  $types = $query->orConditionGroup()
    ->condition('event_type', 'BILLING.PLAN.%', 'LIKE')
    ->condition('event_type', 'CATALOG.PRODUCT.%', 'LIKE');
  $updated = $query
    ->fields([
      'status' => 'processed',
      'changed' => \Drupal::time()->getRequestTime(),
    ])
    ->condition($types)
    ->execute();

  return (string) t('Marked @count PayPal catalog events as non-actionable.', ['@count' => $updated]);
}

/**
 * Adds immutable subscription checkout correlation and recovery snapshots.
 */
function commerce_lms_entitlements_update_10015(): string {
  $schema = \Drupal::database()->schema();
  $definition = commerce_lms_entitlements_schema();
  $added = 0;

  foreach (['checkout_token', 'checkout_snapshot'] as $field) {
    if (!$schema->fieldExists('commerce_lms_entitlement', $field)) {
      $schema->addField('commerce_lms_entitlement', $field, $definition['commerce_lms_entitlement']['fields'][$field]);
      $added++;
    }
  }
  if (!$schema->indexExists('commerce_lms_entitlement', 'checkout_token')) {
    $schema->addUniqueKey('commerce_lms_entitlement', 'checkout_token', ['checkout_token']);
  }
  if (!$schema->fieldExists('commerce_lms_entitlement_event', 'gateway_id')) {
    $schema->addField('commerce_lms_entitlement_event', 'gateway_id', $definition['commerce_lms_entitlement_event']['fields']['gateway_id']);
    $added++;
  }

  return (string) t('Added @count subscription checkout recovery fields.', ['@count' => $added]);
}
