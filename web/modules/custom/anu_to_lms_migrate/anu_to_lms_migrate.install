/**
 * Removes migrated stale activities that no current lesson references.
 */
function anu_to_lms_migrate_update_10015(): void {
  $deleted = _anu_to_lms_migrate_delete_stale_activity_map_rows([
    'anu_to_lms_paragraph_lesson_sections' => [
      'lesson_text',
      'lesson_embedded_video',
      'lesson_audio',
    ],
  ]);

  \Drupal::logger('anu_to_lms_migrate')->notice(
    'Deleted @count stale migrated LMS activities.',
    ['@count' => $deleted],
  );

  \Drupal::service('plugin.manager.migration')->clearCachedDefinitions();
}

