/**
 * Installs the LMS administrative course View when it is missing.
 */
function anu_to_lms_migrate_update_10007(): void {
  if (\Drupal::configFactory()->get('views.view.courses_admin')->isNew()) {
    // Some existing sites enabled LMS before the courses_admin default View
    // was available. Re-running default config installation only creates
    // missing configuration and leaves customized active configuration intact.
    \Drupal::service('config.installer')->installDefaultConfig('module', 'lms');
  }
}

/**
 * Makes the LMS administrative course View show every course.
 */
function anu_to_lms_migrate_update_10008(): void {
  _anu_to_lms_migrate_configure_courses_admin_view();
}

/**
 * Disables entity-access query rewriting on the protected admin listing.
 */
function _anu_to_lms_migrate_configure_courses_admin_view(): void {
  $view = \Drupal::configFactory()->getEditable('views.view.courses_admin');
  if ($view->isNew()) {
    return;
  }

  // The LMS View already requires `create lms_course group`, but its default
  // query still applies Group entity-access rewriting. That hides courses from
  // administrators who did not create or join them, including courses whose
  // original Anu author was preserved by the migration.
  $view->set(
    'display.default.display_options.query.options.disable_sql_rewrite',
    TRUE,
  )->save();
}


/**
 * Adds missing owner memberships and restores Group filtering to the View.
 */
function anu_to_lms_migrate_update_10009(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'lms_course')
    ->execute();

  foreach ($storage->loadMultiple($ids) as $course) {
    _anu_to_lms_migrate_ensure_course_owner_membership($course);
  }

  $view = \Drupal::configFactory()->getEditable('views.view.courses_admin');
  if (!$view->isNew()) {
    // Owner memberships make the courses visible through normal Group query
    // access. Restore access rewriting so the listing does not disclose rows
    // that the current account cannot view.
    $view->set(
      'display.default.display_options.query.options.disable_sql_rewrite',
      FALSE,
    )->save();
  }
}

/**
 * Ensures a course owner also has the creator membership Group expects.
 */
function _anu_to_lms_migrate_ensure_course_owner_membership(
  GroupInterface $course,
): void {
  if ($course->bundle() !== 'lms_course') {
    return;
  }

  $owner = $course->getOwner();
  if ($owner !== NULL && !$course->getMember($owner)) {
    // Entity migration bypasses Group's course creation form, which normally
    // creates this membership when creator_membership is enabled.
    $course->addMember($owner);
  }
}

/**
 * Installs and assigns the LMS teacher role to migrated course owners.
 */
function anu_to_lms_migrate_update_10010(): void {
  \Drupal::service('config.installer')->installDefaultConfig(
    'module',
    'anu_to_lms_migrate',
  );

  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'lms_course')
    ->execute();

  foreach ($storage->loadMultiple($ids) as $course) {
    $owner = $course->getOwner();
    if ($owner !== NULL && !$owner->hasRole('lms_teacher')) {
      $owner->addRole('lms_teacher');
      $owner->save();
    }
    _anu_to_lms_migrate_ensure_course_owner_membership($course);
  }

  \Drupal::service('cache_tags.invalidator')->invalidateTags([
    'config:group.role.lms_course-teacher',
    'group_relationship_list:plugin:group_membership',
  ]);
}

