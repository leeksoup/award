<?php

/**
 * @file
 * Install and update hooks for LMS Runtime.
 */

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Moves checklist and content text into a shared activity body field.
 */
function lms_runtime_update_10001(): void {
  $storage = FieldStorageConfig::loadByName('lms_activity', 'body');
  if ($storage === NULL) {
    $storage = FieldStorageConfig::create([
      'field_name' => 'body',
      'entity_type' => 'lms_activity',
      'type' => 'text_long',
      'cardinality' => 1,
      'translatable' => TRUE,
    ]);
    $storage->save();
  }
  elseif ($storage->getType() !== 'text_long' || $storage->getCardinality() !== 1) {
    throw new \RuntimeException('The existing lms_activity.body storage is not a single-value text_long field.');
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $activity_storage = $entity_type_manager->getStorage('lms_activity');
  foreach ([
    'checklist' => ['field_checklist_body', 'Checklist content'],
    'content' => ['field_content_body', 'Content'],
  ] as $bundle => [$old_field, $label]) {
    if ($entity_type_manager->getStorage('lms_activity_type')->load($bundle) === NULL) {
      continue;
    }

    $field = FieldConfig::loadByName('lms_activity', $bundle, 'body');
    if ($field === NULL) {
      $field = FieldConfig::create([
        'field_storage' => $storage,
        'bundle' => $bundle,
        'label' => $label,
        'required' => FALSE,
        'translatable' => TRUE,
      ]);
      $field->save();
    }

    $ids = $activity_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $bundle)
      ->execute();

    // Check for conflicting manual values before changing any activities in
    // this bundle. Existing body values are never overwritten.
    $activities = $activity_storage->loadMultiple($ids);
    foreach ($activities as $activity) {
      foreach (array_keys($activity->getTranslationLanguages()) as $langcode) {
        $translation = $activity->getTranslation($langcode);
        if (!$translation->hasField($old_field) || $translation->get($old_field)->isEmpty()) {
          continue;
        }
        if (!$translation->get('body')->isEmpty()
          && $translation->get('body')->getValue() !== $translation->get($old_field)->getValue()) {
          throw new \RuntimeException(sprintf(
            'Activity %s (%s) has different %s and body values; resolve the conflict before updating.',
            $activity->id(),
            $langcode,
            $old_field,
          ));
        }
      }
    }

    foreach ($activities as $activity) {
      $changed = FALSE;
      foreach (array_keys($activity->getTranslationLanguages()) as $langcode) {
        $translation = $activity->getTranslation($langcode);
        if ($translation->hasField($old_field)
          && !$translation->get($old_field)->isEmpty()
          && $translation->get('body')->isEmpty()) {
          $translation->set('body', $translation->get($old_field)->getValue());
          $changed = TRUE;
        }
      }
      if ($changed) {
        $activity->save();
      }
    }

    $activity_storage->resetCache($ids);
    foreach ($activity_storage->loadMultiple($ids) as $activity) {
      foreach (array_keys($activity->getTranslationLanguages()) as $langcode) {
        if ($activity->getTranslation($langcode)->get('body')->isEmpty()) {
          throw new \RuntimeException(sprintf(
            'Activity %s (%s) has no body. Fill it before completing the LMS Runtime update.',
            $activity->id(),
            $langcode,
          ));
        }
      }
    }

    $field->setRequired(TRUE)->save();
    $legacy_field = FieldConfig::loadByName('lms_activity', $bundle, $old_field);
    if ($legacy_field !== NULL && $legacy_field->isRequired()) {
      $legacy_field->setRequired(FALSE)->save();
    }

    foreach (['entity_form_display', 'entity_view_display'] as $display_type) {
      $displays = $entity_type_manager->getStorage($display_type)->loadByProperties([
        'targetEntityType' => 'lms_activity',
        'bundle' => $bundle,
      ]);
      foreach ($displays as $display) {
        $component = $display->getComponent($old_field);
        if ($component !== NULL) {
          $display->setComponent('body', $component);
          $display->removeComponent($old_field);
          $display->save();
        }
      }
    }
  }
}

/**
 * Gives the shared activity body field the same label on both bundles.
 */
function lms_runtime_update_10002(): void {
  foreach (['checklist', 'content'] as $bundle) {
    $field = FieldConfig::loadByName('lms_activity', $bundle, 'body');
    if ($field !== NULL && $field->label() !== 'Body') {
      $field->setLabel('Body')->save();
    }
  }
}

/**
 * Copies legacy body values into their matching activity revisions.
 */
function lms_runtime_update_10003(): void {
  $body_storage = FieldStorageConfig::loadByName('lms_activity', 'body');
  if ($body_storage === NULL
    || $body_storage->getType() !== 'text_long'
    || $body_storage->getCardinality() !== 1) {
    throw new \RuntimeException('The shared lms_activity.body storage must be a single-value text_long field.');
  }

  $database = \Drupal::database();
  $table_mapping = \Drupal::entityTypeManager()
    ->getStorage('lms_activity')
    ->getTableMapping();
  $body_table = $table_mapping->getDedicatedRevisionTableName($body_storage);
  if (!$database->schema()->tableExists($body_table)) {
    throw new \RuntimeException(sprintf('Missing activity body revision table %s.', $body_table));
  }
  $body_value_column = $table_mapping->getFieldColumnName($body_storage, 'value');
  $body_format_column = $table_mapping->getFieldColumnName($body_storage, 'format');

  $legacy_fields = [
    'checklist' => 'field_checklist_body',
    'content' => 'field_content_body',
  ];
  foreach ($legacy_fields as $bundle => $legacy_name) {
    if (\Drupal::entityTypeManager()->getStorage('lms_activity_type')->load($bundle) === NULL) {
      continue;
    }
    if (FieldConfig::loadByName('lms_activity', $bundle, 'body') === NULL) {
      throw new \RuntimeException(sprintf('Missing shared body field on %s activities.', $bundle));
    }

    $legacy_storage = FieldStorageConfig::loadByName('lms_activity', $legacy_name);
    if ($legacy_storage === NULL
      || $legacy_storage->getType() !== 'text_long'
      || $legacy_storage->getCardinality() !== 1) {
      throw new \RuntimeException(sprintf('The legacy %s storage must be a single-value text_long field.', $legacy_name));
    }
    $legacy_table = $table_mapping->getDedicatedRevisionTableName($legacy_storage);
    if (!$database->schema()->tableExists($legacy_table)) {
      throw new \RuntimeException(sprintf('Missing legacy activity revision table %s.', $legacy_table));
    }
    $legacy_value_column = $table_mapping->getFieldColumnName($legacy_storage, 'value');
    $legacy_format_column = $table_mapping->getFieldColumnName($legacy_storage, 'format');

    $query = $database->select($legacy_table, 'legacy')
      ->fields('legacy', [
        'bundle', 'deleted', 'entity_id', 'revision_id', 'langcode', 'delta',
        $legacy_value_column, $legacy_format_column,
      ])
      ->condition('bundle', $bundle)
      ->condition('deleted', 0);
    foreach ($query->execute() as $legacy) {
      if ((int) $legacy->delta !== 0) {
        throw new \RuntimeException(sprintf(
          'Activity %s revision %s has an unexpected %s delta %s.',
          $legacy->entity_id,
          $legacy->revision_id,
          $legacy_name,
          $legacy->delta,
        ));
      }
      $key = [
        'entity_id' => $legacy->entity_id,
        'revision_id' => $legacy->revision_id,
        'langcode' => $legacy->langcode,
        'delta' => $legacy->delta,
        'deleted' => 0,
      ];
      $existing = $database->select($body_table, 'body')
        ->fields('body', [$body_value_column])
        ->condition('entity_id', $key['entity_id'])
        ->condition('revision_id', $key['revision_id'])
        ->condition('langcode', $key['langcode'])
        ->condition('delta', $key['delta'])
        ->condition('deleted', 0)
        ->execute()
        ->fetchField();
      $value = $legacy->{$legacy_value_column};
      $format = $legacy->{$legacy_format_column};

      if ($existing === FALSE) {
        $database->insert($body_table)
          ->fields($key + [
            'bundle' => $bundle,
            $body_value_column => $value,
            $body_format_column => $format,
          ])
          ->execute();
      }
      elseif (($existing === NULL || $existing === '') && $value !== NULL && $value !== '') {
        $database->update($body_table)
          ->fields([
            $body_value_column => $value,
            $body_format_column => $format,
          ])
          ->condition('entity_id', $key['entity_id'])
          ->condition('revision_id', $key['revision_id'])
          ->condition('langcode', $key['langcode'])
          ->condition('delta', $key['delta'])
          ->condition('deleted', 0)
          ->execute();
      }
    }
  }
}
