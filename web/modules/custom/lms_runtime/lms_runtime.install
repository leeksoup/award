<?php

/**
 * @file
 * Install hooks for LMS Runtime.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function lms_runtime_install(): void {
  $config = \Drupal::configFactory()->getEditable(
    'core.entity_view_display.lms_activity.video.default',
  );
  if ($config->isNew()) {
    return;
  }

  $dependencies = $config->get('dependencies.module') ?? [];
  $dependencies = array_values(array_diff($dependencies, ['anu_to_lms_migrate']));
  $dependencies[] = 'lms_runtime';
  sort($dependencies);

  $config
    ->set('dependencies.module', $dependencies)
    ->set('content.field_video_url.type', 'safe_video_embed')
    ->save();
}
