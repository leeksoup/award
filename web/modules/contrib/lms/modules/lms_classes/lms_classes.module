<?php

/**
 * @file
 * LMS Classes module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\lms\Entity\Bundle\Course;
use Drupal\lms_classes\Hook\LmsClassesMembershipHooks;

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
#[LegacyHook]
function lms_classes_form_group_relationship_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(LmsClassesMembershipHooks::class)->groupRelationshipFormAlter($form, $form_state);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
#[LegacyHook]
function lms_classes_form_group_relationship_confirm_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(LmsClassesMembershipHooks::class)->groupRelationshipFormAlter($form, $form_state);
}

/**
 * Implements hook_lms_course_link().
 */
#[LegacyHook]
function lms_classes_lms_course_link(Course $course, AccountInterface $current_user, CacheableMetadata $cacheability): array {
  return \Drupal::service(LmsClassesMembershipHooks::class)->lmsCourseLink($course, $current_user, $cacheability);
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
#[LegacyHook]
function lms_classes_group_insert(GroupInterface $group): void {
  \Drupal::service(LmsClassesMembershipHooks::class)->groupInsert($group);
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
#[LegacyHook]
function lms_classes_group_relationship_presave(GroupRelationshipInterface $group_relationship): void {
  \Drupal::service(LmsClassesMembershipHooks::class)->invalidateRelationshipTags($group_relationship);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for group relationships.
 */
#[LegacyHook]
function lms_classes_group_relationship_delete(GroupRelationshipInterface $group_relationship): void {
  \Drupal::service(LmsClassesMembershipHooks::class)->invalidateRelationshipTags($group_relationship);
}
