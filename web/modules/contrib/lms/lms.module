#[LegacyHook]
function lms_lms_course_status_presave(CourseStatus $course_status): void {
  \Drupal::service('lms.hook.entity')->lmsCourseStatusPresave($course_status);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for lesson statuses.
 */
#[LegacyHook]
function lms_lms_lesson_status_delete(LessonStatus $lesson_status): void {
  \Drupal::service('lms.hook.entity')->lmsLessonStatusDelete($lesson_status);
}

/**
 * Implements hook_element_info_alter().
 */
#[LegacyHook]
function lms_element_info_alter(array &$types): void {
  \Drupal::service('lms.hook.other')->elementInfoAlter($types);
}

/**
 * Implements hook_query_TAG_alter().
 */
#[LegacyHook]
function lms_query_lms_activity_access_alter(AlterableInterface $query): void {
  \Drupal::service('lms.hook.query')->lmsActivityQueryAccessAlter($query);
