/**
 * Implements hook_entity_bundle_info().
 */
#[LegacyHook]
function lms_entity_bundle_info(): array {
  return \Drupal::service('lms.hook.entity')->entityBundleInfo();
}

/**
 * Implements hook_token_info().
 */
#[LegacyHook]
function lms_token_info(): array {
  return \Drupal::service('lms.hook.tokens')->tokenInfo();
}

/**
 * Implements hook_tokens().
 */
#[LegacyHook]
function lms_tokens(string $type, array $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata): array {
  return \Drupal::service('lms.hook.tokens')->tokens($type, $tokens, $data, $options, $bubbleable_metadata);
}

/**
 * Implements hook_page_top().
 */
#[LegacyHook]
function lms_page_top(array &$page_top): void {
