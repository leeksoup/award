<?php

/**
 * @file
 * LMS module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\lms\Entity\CourseStatus;
use Drupal\lms\Entity\LessonStatus;
use Drupal\user\UserInterface;

/**
 * Implements hook_entity_bundle_info_alter().
 */
#[LegacyHook]
function lms_entity_bundle_info_alter(array &$bundles): void {
  \Drupal::service('lms.hook.entity')->entityBundleInfoAlter($bundles);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
#[LegacyHook]
function lms_user_delete(UserInterface $user): void {
  \Drupal::service('lms.hook.entity')->userDelete($user);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
#[LegacyHook]
function lms_group_delete(GroupInterface $group): void {
  \Drupal::service('lms.hook.entity')->groupDelete($group);
}

/**
 * Alter Views exposed forms.
 */
#[LegacyHook]
function lms_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service('lms.hook.form')->formViewsExposedFormAlter($form, $form_state);
}

/**
 * Alter Course form.
 */
#[LegacyHook]
function lms_form_group_form_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service('lms.hook.form')->groupFormAlter($form, $form_state);
}

/**
 * Restricts user access to courses and their content.
 *
 * Implements hook_ENTITY_TYPE_access().
 */
#[LegacyHook]
function lms_group_access(GroupInterface $group, string $operation, AccountInterface $account): AccessResultInterface {
  return \Drupal::service('lms.hook.entity')->groupAccess($group, $operation, $account);
}

/**
 * Implements hook_entity_field_access().
 */
#[LegacyHook]
function lms_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account): AccessResultInterface {
  return \Drupal::service('lms.hook.entity')->entityFieldAccess($operation, $field_definition, $account);
}

/**
 * Implements hook_entity_base_field_info().
 */
#[LegacyHook]
function lms_entity_base_field_info(EntityTypeInterface $entity_type): array {
  return \Drupal::service('lms.hook.entity')->entityBaseFieldInfo($entity_type);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for Course statuses.
 */
#[LegacyHook]
function lms_lms_course_status_delete(CourseStatus $course_status): void {
  \Drupal::service('lms.hook.entity')->lmsCourseStatusDelete($course_status);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for Course statuses.
